# ─── D-ID ───────────────────────────────────────────────────────────
# API key from https://studio.d-id.com/account-settings
D_ID_API_KEY=

# ─── D-ID avatars (V4 expressive presenter_id) ─────────────────────
# One unique face per VC. List all: GET https://api.d-id.com/expressives/avatars
# Marcus Chen — skeptical male (Richard)
D_ID_PRESENTER_SKEPTIC=public_richard_sport_elegant@avt_Z1tYgP
# Sarah Kim — excited female (Amber)
D_ID_PRESENTER_EXCITED=public_amber_sport_elegant@avt_s8NZJC
# James Okafor — operator male (Adam, elegant)
D_ID_PRESENTER_OPERATOR=public_adam_elegant@avt_t8BndT

# Optional fallback if persona-specific IDs are unset
# D_ID_PRESENTER_ID=public_mia_elegant@avt_TJ0Tq5

# ─── ElevenLabs ─────────────────────────────────────────────────────
# API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Secret ID from D-ID (NOT ElevenLabs). Auto-created on first session if omitted.
# Create manually: POST https://api.d-id.com/secrets with your ElevenLabs API key.
D_ID_ELEVENLABS_SECRET_ID=

# Deprecated — was confused with ElevenLabs workspace secrets. Use D_ID_ELEVENLABS_SECRET_ID instead.
# ELEVENLABS_SECRET_ID=

# One ElevenLabs Conversational AI agent per persona (create in dashboard)
# PitchBack syncs persona prompts on each session (not voice — use your ElevenLabs dashboard for TTS).
# Set ELEVEN_SYNC_AGENTS=false to skip all agent PATCHes.
# ELEVEN_SYNC_TURN=false — keep turn-taking from ElevenLabs dashboard only.
# ELEVEN_SYNC_FIRST_MESSAGE=true — overwrite first_message from PitchBack (default: keep dashboard).
# NEXT_PUBLIC_DEFER_MIC_UNTIL_GREETING=false — publish mic immediately (may cut off greeting via echo).
ELEVEN_AGENT_ID_SKEPTIC=
ELEVEN_AGENT_ID_EXCITED=
ELEVEN_AGENT_ID_OPERATOR=

# Optional: force a voice_id (overrides dashboard). Leave unset to keep each agent's voice as configured in ElevenLabs.
# ELEVEN_VOICE_ID_SKEPTIC=
# ELEVEN_VOICE_ID_EXCITED=
# ELEVEN_VOICE_ID_OPERATOR=

# Client tool ID for set_avatar_emotion (auto-detected if blank).
# Must exist in the same ElevenLabs account as ELEVENLABS_API_KEY — stale IDs cause sync 404.
# ELEVEN_EMOTION_TOOL_ID=

# Reuse D-ID agents across sessions (paste from create-session response tip).
# Comment out all D_ID_AGENT_* when you switch ElevenLabs accounts so new agents are created.
# D_ID_AGENT_SKEPTIC=
# D_ID_AGENT_EXCITED=
# D_ID_AGENT_OPERATOR=

# Optional: pre-created D-ID agents (legacy — prefer D_ID_AGENT_* above)
NEXT_PUBLIC_AGENT_SKEPTIC=
NEXT_PUBLIC_KEY_SKEPTIC=
NEXT_PUBLIC_AGENT_EXCITED=
NEXT_PUBLIC_KEY_EXCITED=
NEXT_PUBLIC_AGENT_OPERATOR=
NEXT_PUBLIC_KEY_OPERATOR=

# Comma-separated origins allowed for D-ID client keys (fixes CORS/401 on localhost)
# The create-session API also adds your browser Origin automatically (e.g. LAN IP).
D_ID_ALLOWED_DOMAINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.8:3000
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
